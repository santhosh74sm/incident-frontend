# =============================================================================
# Frontend Environment Variables — Incident Tracking System
# =============================================================================
# Copy this file to `.env` and fill in your values. Never commit `.env` to git.
#
# Resolution order (first non-empty wins):
#   1. REACT_APP_API_URL
#   2. REACT_APP_API_BASE_URL   <-- defined in .env / .env.production / .env.development
#   3. REACT_APP_API_BASE
#   4. Hardcoded default: http://localhost:5000 (dev) / https://incident-backend-rzmq.onrender.com (prod)
# =============================================================================

# ---------- Required ----------

# Backend API base URL (no trailing slash).
# For development: http://localhost:5000
# For production:  https://your-backend-domain.com
REACT_APP_API_URL=http://localhost:5000

# ---------- Optional Aliases ----------

# Alternative env var names (used as fallbacks in the resolution chain).
# REACT_APP_API_BASE_URL=http://localhost:5000
# REACT_APP_API_BASE=http://localhost:5000
